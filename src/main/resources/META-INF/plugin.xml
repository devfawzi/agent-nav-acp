<idea-plugin>
    <id>com.claudeacp.bridge</id>
    <name>AgentNav ACP</name>
    <vendor email="you@example.com" url="https://github.com/you">YourName</vendor>

    <description><![CDATA[
        <h2>AgentNav ACP</h2>
        <p>Plugin IntelliJ qui intègre Claude Code dans l'IDE via le protocole ACP
        (Agent Client Protocol). Inspiré de Cursor avec une UX adaptée à JetBrains.</p>
        <ul>
            <li>Chat multi-sessions avec rendu Markdown</li>
            <li>Diff viewer natif auto-ouvert à chaque modification</li>
            <li>Liste Pending Changes avec Accept/Reject par fichier ou globaux</li>
            <li>Bloc Thinking repliable + Cards file changes + Run command Running/Done</li>
            <li>Auto-discovery des binaires claude/npx, override via Settings</li>
        </ul>
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window unique : chat + liste prompts + liste pending changes -->
        <toolWindow id="AgentNav ACP"
                    anchor="right"
                    factoryClass="com.claudeacp.ClaudeACPToolWindowFactory"
                    icon="AllIcons.Actions.Lightning"/>

        <!-- Services -->
        <projectService serviceImplementation="com.claudeacp.ClaudeACPService"/>
        <projectService serviceImplementation="com.claudeacp.PromptHistoryService"/>
        <projectService serviceImplementation="com.claudeacp.PendingChangesService"/>
        <projectService serviceImplementation="com.claudeacp.DiffViewerManager"/>
        <applicationService serviceImplementation="com.claudeacp.AgentSettings"/>

        <!-- Settings : Tools → AgentNav ACP -->
        <applicationConfigurable
            parentId="tools"
            instance="com.claudeacp.AgentSettingsConfigurable"
            id="com.claudeacp.settings"
            displayName="AgentNav ACP"/>
    </extensions>
</idea-plugin>
